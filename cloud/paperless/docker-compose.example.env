# Copy to docker-compose.env (env_file for the webserver).
USERMAP_UID=1000
USERMAP_GID=1000
PAPERLESS_URL=https://your-host.your-tailnet.ts.net:8000
# Generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_TIME_ZONE=Europe/Zagreb
PAPERLESS_OCR_LANGUAGE=hrv+eng
PAPERLESS_OCR_LANGUAGES=hrv eng
