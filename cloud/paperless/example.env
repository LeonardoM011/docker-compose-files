# Copy to .env. Compose reads it for interpolation, and the webserver also loads
# it as its env_file.

# Makes the webserver container paperless-webserver-1, which ../backup.sh and
# ../ofelia/config.ini address by name
COMPOSE_PROJECT_NAME=paperless

# Postgres password for both db and webserver. Postgres applies it only when the
# database is first created; changing it later also needs ALTER USER.
PAPERLESS_DBPASS=change-me

USERMAP_UID=1000
USERMAP_GID=1000
PAPERLESS_URL=https://your-host.your-tailnet.ts.net:8000
# Generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_TIME_ZONE=Europe/Zagreb
PAPERLESS_OCR_LANGUAGE=hrv+eng
PAPERLESS_OCR_LANGUAGES=hrv eng
